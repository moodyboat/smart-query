# 部署环境变量样例（复制为 .env 并按需修改）
# 虚拟机端口：仅前端默认对外开放；数据库和后端仅宿主机可访问。
FRONTEND_BIND_ADDRESS=0.0.0.0
FRONTEND_HOST_PORT=80
BACKEND_BIND_ADDRESS=127.0.0.1
BACKEND_HOST_PORT=9001
DM_BIND_ADDRESS=127.0.0.1
DM_HOST_PORT=5236

# 可替换为私有仓库地址或离线导入后的镜像名。
DM_IMAGE=dm8_single:dm8_20241022_rev244896_x86_rh6_64
REDIS_IMAGE=redis:7-alpine
BACKEND_IMAGE=smart-query-backend:latest
FRONTEND_IMAGE=smart-query-frontend:latest
PYTHON_IMAGE=smart-query-python:latest
# PyPI 较慢时可改为企业镜像源或区域镜像源，例如：https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# 默认模型：DeepSeek（也可保留 GLM 作为可选模型）
DEEPSEEK_API_KEY=
GLM_API_KEY=

# 系统库：达梦 DM8（信创/私有化部署默认；COMPATIBLE_MODE=4 已开 MySQL 兼容）
# Compose 默认连接 dm8 服务；若使用外部实例，将 DM_HOST 改为其可访问地址。
# 后端使用 SYSDBA 登录后执行 SET SCHEMA SMART_QUERY。
DM_HOST=dm8
DM_PORT=5236
DM_USERNAME=SYSDBA
DM_PASSWORD=Dameng123
DM_SCHEMA=SMART_QUERY

# 鉴权：生产部署必须改成独立随机串（至少 32 字节）
JWT_SECRET=smart-query-default-jwt-secret-key-change-me-in-production-min-32-bytes
JWT_EXPIRATION_MINUTES=1440
# 默认管理员（首次启动注入，之后改 yml/env 不影响已存在账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
