# 部署环境变量样例（复制为 .env 并按需修改）
# 问数必需：GLM API Key（不设则用 application.yml 内置默认值）
GLM_API_KEY=

# MySQL 系统库密码（与 docker-compose mysql 服务的 MYSQL_ROOT_PASSWORD 一致）
MYSQL_PASSWORD=900110

# 鉴权：JWT 密钥（生产必须改成随机串，至少 32 字节）
JWT_SECRET=smart-query-default-jwt-secret-key-change-me-in-production-min-32-bytes
JWT_EXPIRATION_MINUTES=1440
# 默认管理员（首次启动注入，之后改 yml/env 不影响已存在账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
