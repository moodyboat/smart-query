# 部署环境变量样例（复制为 .env 并按需修改）
# 问数必需：GLM API Key（不设则用 application.yml 内置默认值）
GLM_API_KEY=

# 系统库：达梦 DM8（信创/私有化部署默认；COMPATIBLE_MODE=4 已开 MySQL 兼容）
# DM8 默认在宿主机或独立容器提供 5236 端口；后端用 SYSDBA 登录后 SET SCHEMA SMART_QUERY 切库
DM_HOST=host.docker.internal
DM_PORT=5236
DM_USERNAME=SYSDBA
DM_PASSWORD=Dameng123
DM_SCHEMA=SMART_QUERY

# 业务库示例容器（docker-compose 中的 mysql 服务，仅作"业务库示例数据"用，
# 不是系统库；客户真实业务库通过 UI 添加动态数据源，可为 MySQL/PostgreSQL/DM/GBase 任意）
MYSQL_PASSWORD=900110

# 鉴权：JWT 密钥（生产必须改成随机串，至少 32 字节）
JWT_SECRET=smart-query-default-jwt-secret-key-change-me-in-production-min-32-bytes
JWT_EXPIRATION_MINUTES=1440
# 默认管理员（首次启动注入，之后改 yml/env 不影响已存在账号）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
